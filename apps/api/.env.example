# 复制为 apps/api/.env 后按需修改。
# 该文件会被完整载入 os.environ，因此下列所有变量（含 IMAGE_PROVIDER_* / REDIS_URL /
# PLATFORM_*）都能从这里配置；shell / compose 中已存在的同名变量优先，不会被覆盖。
# Docker 部署请把 IMAGE_PROVIDER_* 写进 infra/.env（compose 变量替换），而不是这里。
# 本地开发默认用 PostgreSQL（宿主机 127.0.0.1:5433）。
# 起库（二选一，都指向下面这行）：
#   本机 PG 不用容器：cd infra && ./scripts/dev-pg.sh up
#   只起 Docker 库：  cd infra && ./scripts/dev-db.sh up
DATABASE_URL=postgresql+psycopg://hanyue:hanyue_dev_pwd@127.0.0.1:5433/hanyue
# 没有 Docker 时可退回单文件库（仅本地调试；生产门禁会拒绝 SQLite）：
# DATABASE_URL=sqlite:///./hanyue.db
# 仅本地开发可用默认值；设 ENVIRONMENT=production 时必须是 ≥32 字符随机值，否则拒绝启动
SECRET_KEY=dev-only-change-me
ENVIRONMENT=development
# 开发态便利入口：按任意 subject 换 token（不校验密码）。本地开发可留 true；
# 生产必须 false —— 正式登录走邮箱密码（/auth/register、/auth/login）。
ALLOW_DEV_LOGIN=true
# 开放注册：默认 false。库里还没有任何密码账号时会自动放行首个账号（bootstrap）；
# 公网部署建议保持 false，用 apps/api/scripts/create_user.py 建账号。
# ALLOW_REGISTRATION=false
# 密码策略与在线爆破防护
# PASSWORD_MIN_LENGTH=8
# AUTH_LOCK_THRESHOLD=5
# AUTH_LOCK_MINUTES=15
TOKEN_TTL_SECONDS=604800
# running 任务超过该秒数未推进视为崩溃，启动时回收
JOB_LEASE_SECONDS=300
# 单次上传硬上限（字节），即使不带签名上传会话也生效
MAX_UPLOAD_BYTES=20971520
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 运行日志：级别（DEBUG/INFO/WARNING/ERROR）、目录（留空为 <STORAGE_DIR>/logs）、
# 单文件上限与保留份数。API 写 api.log，独立 Worker 写 worker.log。
LOG_LEVEL=INFO
# LOG_DIR=./storage/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# 生产示例（PostgreSQL）：镜像已通过 requirements-prod.txt 安装 psycopg
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/hanyue

# 跨进程任务队列。留空时使用 API 内置线程池后端（任务状态同样落库、可查询）；
# 配置后请用 apps/worker/worker.py 或 docker compose 的 worker 服务消费。
# REDIS_URL=redis://127.0.0.1:6379/0

# SSRF 可信主机白名单（逗号分隔域名）。内网自建网关（如内部 LLM 代理 lab.iwhalecloud.com）
# 的域名必然解析到私网地址，会被 SSRF 防护误杀；在这里显式登记的域名跳过「解析结果为
# 内网地址」这一条拦截。HTTPS、端口白名单与 localhost/元数据等字面量黑名单仍然生效。
# SSRF_TRUSTED_HOSTS=lab.iwhalecloud.com

# AI 生图供应商（也可在设置页给模型登记 image.generate 能力）
# 三个值必须同时存在才生效；代码会请求 {BASE_URL}/images/generations，
# 因此 BASE_URL 填到 /v1 即可，不要带 /images/generations。
# 必须是公网 HTTPS 地址：SSRF 防护会拒绝 http://、localhost、内网 IP 与云元数据地址。
# IMAGE_PROVIDER_BASE_URL=https://api.example.com/v1
# IMAGE_PROVIDER_API_KEY=sk-...
# IMAGE_PROVIDER_MODEL=gpt-image-1
# 可选：环境变量供应商支持的精确尺寸（JSON），例如 {"1:1":"1024x1024","3:2":"1536x1024"}
# IMAGE_PROVIDER_SUPPORTED_SIZES={"1:1":"1024x1024","3:2":"1536x1024"}

# Phase 0 平台能力核验证据文件；不存在时五个平台一律 confirmed=false
# 路径相对当前工作目录，建议写绝对路径或 infra/platform-evidence.json 的完整路径
# PLATFORM_EVIDENCE_FILE=../../infra/platform-evidence.json

# 平台官方 OAuth（逐平台配置，前缀为 PLATFORM_<大写平台代码>_）
# PLATFORM_REDIRECT_BASE=http://localhost:5173
# PLATFORM_XIAOHONGSHU_CLIENT_ID=
# PLATFORM_XIAOHONGSHU_CLIENT_SECRET=
# PLATFORM_XIAOHONGSHU_AUTH_URL=
# PLATFORM_XIAOHONGSHU_TOKEN_URL=
# PLATFORM_XIAOHONGSHU_API_BASE=
# PLATFORM_XIAOHONGSHU_SCOPES=
# 令牌验证端点（相对 API_BASE 的路径）。各平台用户信息接口路径不同，
# 必须按官方文档显式配置；不配置时「验证授权」会明确报错，不会猜测接口。
# PLATFORM_XIAOHONGSHU_VERIFY_PATH=/userinfo

# 微信公众号草稿箱（AppID + AppSecret，不需要 OAuth）
# 与其它四个平台不同：公众号没有面向第三方创作工具的授权码流程。
# 只推送到草稿箱，不群发。需在公众号后台把本服务器公网出口 IP 加入 IP 白名单，
# 且账号必须已认证（未认证调用草稿箱会返回 48001）。
# WECHAT_MP_APPID=wx1234567890abcdef
# WECHAT_MP_APPSECRET=your-app-secret
# WECHAT_MP_AUTHOR=你的署名
# WECHAT_MP_API_BASE=https://api.weixin.qq.com
# WECHAT_MP_NEED_OPEN_COMMENT=0
# WECHAT_MP_ONLY_FANS_CAN_COMMENT=0

# 热点选题：采集不在服务端。每个平台一条「热点入库」脚本定时任务，
# 脚本自己请求、自己解析，再调 POST /api/v1/hot-topics/ingest（见 docs/hot-topics-config.md）。
# 这里只剩「重算评分」按钮的冷却（秒），0 表示不限制。
# HOT_TOPICS_REFRESH_COOLDOWN=15

# 定时任务（docs/scheduled-tasks.md）：APScheduler 只当定时器，执行仍走 background_jobs
# 总开关；false 时不装载调度器，接口与表照常可用（排障用）
# SCHEDULER_ENABLED=true
# 错过触发点的宽限秒数（默认值，单任务可覆盖）：超过即记 missed，不补跑历史
# SCHEDULER_MISFIRE_GRACE=300
# 连续失败多少次自动暂停任务；0 表示不自动暂停
# SCHEDULER_MAX_CONSECUTIVE_FAILURES=3
# system 级任务的写权限：dev（仅开发态）/ any（任何登录用户）/ never（只读，seed 维护）
# SCHEDULER_SYSTEM_WRITE=dev
