# infra/docker-compose.yml 的变量来源。用法：cp .env.example .env
# 本文件被 .gitignore 忽略的只有 .env 本体，示例文件可入库。
#
# 生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"
# deploy.sh 的 `init-env` 子命令会自动生成下面两项并写入 .env。

# ── 必填（缺失时 compose 直接报错，不会用弱默认值启动）──────────────
SECRET_KEY=替换成至少32字符的随机字符串
POSTGRES_PASSWORD=替换成强密码

# ── 数据库（有默认值）────────────────────────────────────────────
POSTGRES_USER=hanyue
POSTGRES_DB=hanyue

# ── 端口与区域 ─────────────────────────────────────────────────
# 对外入口端口（nginx）。生产建议前面再挂一层 Caddy/Nginx 做 TLS。
WEB_PORT=8080
# API 仅绑定宿主机 127.0.0.1，用于 curl 调试；公网不要直接暴露
API_PORT=8000
# 容器时区；影响日志时间与「今天」的判定
TZ=Asia/Shanghai

# ── 登录与账号 ────────────────────────────────────────────────
# 已接入邮箱密码认证：/auth/register、/auth/login、/auth/password。
# 首个账号（镜像内自带 scripts，容器会按依赖先起 db）：
#   ./scripts/deploy.sh create-user create --email you@example.com
# 从旧开发态账号迁移（id 不变，稿件/素材/发布任务都保留）：
#   ./scripts/deploy.sh create-user attach --subject local-creator --email you@example.com
# 开发态免密入口（任意 subject 换 token）只在 development 下开放；
# 公网部署务必保持 production + false。
ENVIRONMENT=production
ALLOW_DEV_LOGIN=false
# 开放注册：默认关闭。打开后任何能访问页面的人都能注册账号，公网慎用。
ALLOW_REGISTRATION=false
# 浏览器同源访问时用不到；直接跨域调 API 时才需要改成实际前端地址
# CORS_ORIGINS=http://localhost:8080

# ── 构建加速（国内网络）───────────────────────────────────────
# registry.npmjs.org 在国内网络经常超时，默认走镜像；非中国网络可清空这几项。
# 只要 NPM_REGISTRY 非空，镜像内会同时设置 replace-registry-host=always，
# 把 lock 里写死的 resolved 主机改写成该源，不受 lock 生成地影响。
NPM_REGISTRY=https://registry.npmmirror.com
# pip：Debian slim 镜像内 pip 走清华源（换 http 源需额外 trusted-host，这里用 https）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# apt（api/worker 装 ffmpeg 与中文字体时用）：替换 deb.debian.org / security.debian.org
# 只写主机名，不带 http:// 、不带结尾斜杠；留空则走官方源
APT_MIRROR=mirrors.aliyun.com
# apk（web 装 tzdata 时用）：替换 dl-cdn.alpinelinux.org；也可写完整 base URL
APK_MIRROR=mirrors.aliyun.com
#
# ── 腾讯云 CVM 上构建：mirrors.tencentyun.com 是 VPC 内网源，免流量最快，
#    但只在腾讯云机器上可达。整组替换成下面这行组即可：
# PIP_INDEX_URL=http://mirrors.tencentyun.com/pypi/simple
# PIP_TRUSTED_HOST=mirrors.tencentyun.com
# APT_MIRROR=mirrors.tencentyun.com
# APK_MIRROR=mirrors.tencentyun.com
# （npm 腾讯云无镜像，保持 npmmirror；基础镜像拉取跑 ./scripts/deploy.sh mirror，
#   脚本在 CVM 上会自动探测并优先用内网加速 mirror.ccs.tencentyun.com）
#
# 基础镜像（python / node / nginx / postgres / redis）的「拉取」不走构建参数，
# 由 docker daemon 的 registry-mirrors 接管：./scripts/deploy.sh mirror

# ── AI 生图供应商（三个值齐全才生效）────────────────────────────
IMAGE_PROVIDER_BASE_URL=
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_MODEL=

# ── 微信公众号草稿箱（AppID + AppSecret，不是 OAuth）─────────────
# 需把容器出口公网 IP 加入公众号 IP 白名单；账号须已认证才有草稿箱权限。
# 只推送草稿，不群发。
WECHAT_MP_APPID=
WECHAT_MP_APPSECRET=
WECHAT_MP_AUTHOR=
# WECHAT_MP_API_BASE=
# WECHAT_MP_NEED_OPEN_COMMENT=
# WECHAT_MP_ONLY_FANS_CAN_COMMENT=

# ── 备份保留（deploy.sh backup 使用）───────────────────────────
BACKUP_KEEP_DAYS=14
