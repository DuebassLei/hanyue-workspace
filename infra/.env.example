# 复制为 infra/.env 后再执行 docker compose；compose 用 ${VAR:?} 强制要求下列两项。
# 生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=替换成至少32字符的随机字符串
POSTGRES_PASSWORD=替换成强密码

# 可选（有默认值）
POSTGRES_USER=hanyue
POSTGRES_DB=hanyue
CORS_ORIGINS=http://localhost:5173

# AI 生图供应商（三个值齐全才生效）
IMAGE_PROVIDER_BASE_URL=
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_MODEL=

# 平台官方 OAuth 凭据按 PLATFORM_<大写平台代码>_ 前缀在 shell 中导出，
# 或写入本文件（compose 未逐项列出时可自行在 environment 中补充）。

# 微信公众号草稿箱（AppID + AppSecret，不是 OAuth）
# 需把容器出口公网 IP 加入公众号 IP 白名单；账号须已认证才有草稿箱权限。
# 只推送草稿，不群发。
WECHAT_MP_APPID=
WECHAT_MP_APPSECRET=
WECHAT_MP_AUTHOR=
